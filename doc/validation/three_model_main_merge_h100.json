  "resolutions": [
    {
      "area": "Linear",
      "resolution": "Preserve the adaptation native autograd and mul_ir serial forward/dX, which already extend main SO3 tiles; retain main public SO3 API via a compatibility import. Add legal-grid fallback to auto selection.",
      "evidence": "performance/linear_backward_20261027/summary.json",
      "reason": "One shared serial core, full dX/dW/higher derivatives and indexed/species coverage. Main kernel-only timings do not include the required layout conversion."
    },
    {
      "area": "Uniform1D scheduler",
      "resolution": "Use main modular auto_schedule and migrate output-resident split second adjoints. Preserve main selective first-gradient ABI, scalar CUDA warp reduction, and both native/Triton/Gluon entry points.",
      "evidence": [
        "uniform_performance.json",
        "uniform_more_performance.json",
        "uniform_threshold_performance.json",
        "uniform_auto_validation.json"
      ],
      "reason": "Retain fused and output-resident split policies in one shared scheduler. H100 FP32 auto selects only measured 83-path layouts above measured thresholds; nine-path and unmeasured layouts retain main fused. Explicit 0/1 overrides preserved."
    },
    {
      "area": "Autograd graph connectivity",
      "resolution": "Save public inputs and recreate internal views under backward recording for Uniform1D and Gate.",
      "evidence": "tests_cpu.log; tests_cuda.log",
      "reason": "Upstream forward-created views lose the connection needed for force-loss derivatives."
    },
    {
      "area": "STC",
      "resolution": "Adopt main native grad_x0 and double backward, keep old import via stc.py, remove unconditional CUDA synchronization/timers.",
      "evidence": "tests_merge_additional.log",
      "reason": "Adds trainable-weight CUDA adjoints without introducing a second implementation."
    },
    {
      "area": "FCTP legacy entry",
      "resolution": "Adopt main fused Triton grad_w and double backward for the legacy public entry; retain original public inputs and omit unconditional synchronization/timers. The three-model native CUDA FCTP adapter is unchanged.",
      "evidence": "tests_merge_additional.log",
      "reason": "The old legacy wrapper did not provide grad_w; its lower latency is not a functionally equivalent baseline."
    },
    {
      "area": "Gate/Norm/SH",
      "resolution": "Keep existing measured native CUDA dispatch for adapted models, main public Triton APIs and local FP64/empty/batched-gradient fixes.",
      "evidence": [
        "performance/fasteq_optimization/v8/gate_invariants/SUMMARY.md",
        "performance/fasteq_optimization/v8/norm_trial/FINAL.md",
        "performance/fasteq_optimization/v8/sh/DISPATCH_SUMMARY.md"
      ],
      "reason": "Historical measurements support these domains, not a blanket native win. Prophet FP64 Gate was inconclusive; no general speed claim is made."
    },
    {
      "area": "Tuning controls",
      "resolution": "Honor per-call and environment controls plus main master switch; disabled tuning performs no timing/allocation.",
      "evidence": "test_tuning_controls.log",
      "reason": "Preserve prior callers that pass False and avoid unexpected multi-size tuning in model inference."
    },
    {
      "area": "Packaging/imports",
      "resolution": "Keep main build tooling and lazy Triton exports; let JIT/Triton work without the optional precompiled CUDA library. Package native sources.",
      "evidence": "build_wheel.log",
      "reason": "Main defaults to a Python-only build, so an unconditional .so import failure would break the merged installation."
    },
    {
      "area": "Submodules",
      "resolution": "Retain the tested cuequivariance_torch revision and registered MACE/SevenNet entries.",
      "reason": "Avoid silently replacing the external baseline or removing still-used integrations."
    },
    {
      "area": "Legacy optional tools",
      "resolution": "Preserve the previously present TileLang prototype and CWTP metadata utility; neither is selected by the three-model runtime.",
      "reason": "Main removed these files; retain existing import paths instead of silently deleting optional functionality. TileLang execution is outside this H100 CUDA validation."
    }
  ],
